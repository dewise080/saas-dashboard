<mjml>
  <mj-body background-color="#030b1a">
    <mj-section background-color="#030b1a" padding="28px 0">
      <mj-column width="100%">
        <mj-wrapper padding="0">
          <mj-section background-color="#ffffff" border-radius="18px" padding="0" css-class="card-shadow">
            <mj-section background-color="#0b66f5" border-radius="18px 18px 0 0" padding="24px 28px">
              <mj-column width="100%">
                <mj-text color="#ffffff" font-size="12px" font-weight="700" padding-bottom="8px">Whatsynaptic</mj-text>
                <mj-text color="#ffffff" font-size="26px" font-weight="800" line-height="1.3">{{ subject|default:"Update from Whatsynaptic" }}</mj-text>
              </mj-column>
            </mj-section>
            <mj-section background-color="#ffffff" padding="28px 28px 14px 28px">
              <mj-column width="100%">
                <mj-text font-size="16px" line-height="1.7" color="#0f172a">
                  {% if body_html %}{{ body_html|safe }}{% elif body_text %}{{ body_text|linebreaksbr }}{% else %}We wanted to share a quick update with you.{% endif %}
                </mj-text>
                <mj-text padding="16px" background-color="rgba(117,218,180,0.16)" border-radius="12px" color="#0b66f5" font-size="14px" font-weight="700">Crafted with Whatsynaptic automation</mj-text>
              </mj-column>
            </mj-section>
            <mj-section padding="0 28px 24px 28px" background-color="#ffffff">
              <mj-column width="100%">
                <mj-divider border-color="#e4eaf3" border-width="1px" padding-bottom="12px" />
                <mj-text font-size="13px" color="#6b7a90" line-height="1.6" padding="0">
                  <div>{% trans "Need help?" %}</div>
                  <div>{% trans "You can reply to this email." %}</div>
                  <div><a href="#" style="color:#0b66f5; text-decoration:none;">{% trans "Unsubscribe" %}</a> | <a href="https://whatsynaptic.com/en/" style="color:#0b66f5; text-decoration:none;">Whatsynaptic</a></div>
                </mj-text>
              </mj-column>
            </mj-section>
          </mj-section>
        </mj-wrapper>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
