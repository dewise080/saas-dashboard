# True for development, False for production
DEBUG=True

SECRET_KEY=<STRONG_KEY_HERE>

# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_NAME=appseed_db
# DB_USERNAME=appseed_db_usr
# DB_PASS=pass
# DB_PORT=3306

# Email delivery
EMAIL_PROVIDER=smtp_primary
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional secondary SMTP (used when SECONDARY_EMAIL_HOST is set)
#SECONDARY_EMAIL_HOST=
#SECONDARY_EMAIL_PORT=587
#SECONDARY_EMAIL_USER=
#SECONDARY_EMAIL_PASSWORD=
#SECONDARY_EMAIL_USE_TLS=True
#SECONDARY_EMAIL_USE_SSL=False
#SECONDARY_DEFAULT_FROM_EMAIL=

# Optional ESP via django-anymail
#ANYMAIL_PROVIDER=sendgrid
#ANYMAIL_API_KEY=
#ANYMAIL_API_URL=
#EMAIL_PROVIDERS_JSON={"custom":"value"}

# Chatwoot (optional, for threading replies)
#CHATWOOT_ENABLED=False
#CHATWOOT_BASE_URL=https://app.chatwoot.com
#CHATWOOT_ACCOUNT_ID=1
#CHATWOOT_INBOX_ID=1
#CHATWOOT_API_TOKEN=your_api_access_token
#CHATWOOT_API_PATH=/api/v1  # override to /platform/api/v1 if your instance uses the platform API path
